{
    "provider": "openai",
    "openai": {
        "api_key": "your-openai-api-key-here"
    },
    "venice": {
        "api_key": "your-venice-api-key-here",
        "model": "venice-sd35",
        "edit_model": "firered-image-edit",
        "resolution": "1K"
    },
    "settings": {
        "max_image_size": 1024,
        "timeout": 30
    }
}
